# ---------------------------------------------------------------- Grove CMS (public)
# Site manifest lens:// URI (create it from /admin the first time, then paste here and redeploy once)
NEXT_PUBLIC_GROVE_SITE_URI=
# Comma-separated admin wallets (EOA recommended: Grove verifies edit signatures by recovered address)
NEXT_PUBLIC_ADMIN_ADDRESSES=
# Members content key, public half (raw P-256, 0x04...). Generate with scripts/fulfillment-keygen.mjs
NEXT_PUBLIC_MEMBERS_PUBKEY=

# ---------------------------------------------------------------- membership (public)
# Coinbase CDP project: social sign-in (Google, Apple, X) creates a Coinbase smart wallet.
# Allowlist the site origin in CDP Portal > Embedded Wallets > Domains.
NEXT_PUBLIC_CDP_PROJECT_ID=
# 1 = membership also needs a VQ invitation code (burned onchain)
NEXT_PUBLIC_MEMBERSHIP_INVITE_ONLY=0

# ---------------------------------------------------------------- chain (public)
# Membership needs NEXT_PUBLIC_ACCESS_ADDRESS (VelviqueAccess ERC-1155, ignition/modules/Membership.ts).
# Commerce addresses (catalog, orders, provenance) stay empty for now.
# 84532 Base Sepolia (staging) · 8453 Base mainnet
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# WalletConnect project id from dashboard.reown.com (NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID also works)
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Printed by packages/contracts/script/Deploy.s.sol
NEXT_PUBLIC_ACCESS_ADDRESS=
NEXT_PUBLIC_CATALOG_ADDRESS=
NEXT_PUBLIC_ORDERS_ADDRESS=
NEXT_PUBLIC_PROVENANCE_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=0

# ---------------------------------------------------------------- vault (public)
# Fulfillment wallet (decrypts shipping + inquiries) and its raw P-256 public key (0x04...)
NEXT_PUBLIC_FULFILLER_ADDRESS=
NEXT_PUBLIC_FULFILLMENT_PUBKEY=
# 1 = shipping blobs use Grove generic ACL on VelviqueOrders.isFulfiller; 0 = wallet-only fallback
NEXT_PUBLIC_GROVE_GENERIC_ACL=0

# ---------------------------------------------------------------- 3D / AR (public)
NEXT_PUBLIC_BOTTLE_USDZ=
# Looping video for tier 3 devices
NEXT_PUBLIC_BOTTLE_LOOP=

# ---------------------------------------------------------------- rails (public flags)
NEXT_PUBLIC_RAIL_SWAP=1
NEXT_PUBLIC_RAIL_CARD_US=0

# ---------------------------------------------------------------- server only
RPC_URL_SERVER=
# EIP-712 voucher signer: must hold SIGNER_ROLE on VelviqueAccess
VOUCHER_SIGNER_KEY=
# HMAC secret for typed invitation codes (VQ-XXXX-XXXX-XXXX)
INVITE_CODE_SECRET=
# Coinbase Developer Platform: validates member sessions (CDP end-user tokens), rail C onramp, paymaster
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
PAYMASTER_URL=
# 0x Swap API v2 (rail B)
ZEROX_API_KEY=
# Membership relayer: holds only MINTER_ROLE on VelviqueAccess; fund with a little Base ETH
MEMBERSHIP_MINTER_KEY=
# 0 = allow membership without a linked social (default requires one)
MEMBERSHIP_REQUIRE_SOCIAL=1
# Salt for the onchain identity hash (CDP user id never goes onchain in clear)
MEMBERS_SALT=
# Private half of NEXT_PUBLIC_MEMBERS_PUBKEY (PKCS8 base64): opens sealed members content
MEMBERS_PRIVATE_KEY_PKCS8=
# Wholesale requests by email (Brevo transactional). Unset = placeholder: the form succeeds, nothing is sent.
BREVO_API_KEY=
# Verified sender in Brevo, and the inbox that receives wholesale requests
BREVO_SENDER=
MAYOREO_TO=
